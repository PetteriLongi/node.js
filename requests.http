POST http://127.0.0.1:3000/api/v1/cats
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo0MSwibmFtZSI6IlRlc3RlciIsInVzZXJuYW1lIjoidGVzdCIsImVtYWlsIjoidGVzdEBtZXRyb3BvbGlhLmZpIiwicm9sZSI6InVzZXIiLCJpYXQiOjE3ODg2OTk5ODAsImV4cCI6MTc4ODc4NjM4MH0.ovOP60RyFY4WeifI1YmuCqeON4yf0C1a_tkyg4jLnAY
Content-Type: multipart/form-data; boundary=LargeFileBoundary

--LargeFileBoundary
Content-Disposition: form-data; name="cat_name"

Validation test cat
--LargeFileBoundary
Content-Disposition: form-data; name="weight"

5
--LargeFileBoundary
Content-Disposition: form-data; name="birthdate"

2021-08-20
--LargeFileBoundary
Content-Disposition: form-data; name="cat"; filename="over-10mb.bin"
Content-Type: image/png

< ./public/over-10mb.bin
--LargeFileBoundary--

